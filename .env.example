# Local Ollama HTTP API (never a closed cloud AI provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Swap models without changing code.
# This machine already had gemma4:latest (Best Use of Gemma).
# Also works: qwen3:4b, gemma3:4b, llama3.2:3b
OLLAMA_MODEL=gemma4:latest

# Backend
HOST=127.0.0.1
PORT=8000
